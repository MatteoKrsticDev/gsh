#!/bin/bash
#
# gsh installer - adds the gsh / gsh-update aliases to your shell rc file.
#
# The aliases live inside a delimited, managed block:
#
#     # >>> gsh >>>
#     alias gsh='bash "/path/to/gsh/gsh/main"'
#     alias gsh-update='bash "/path/to/gsh/update"'
#     # <<< gsh <<<
#
# so re-running setup rewrites that block in place instead of appending a
# second copy.  The block is always written last, so it wins over an alias
# left behind by an older installer.
#
# exit codes:  0 ok   1 error (unsupported shell, unwritable rc file, ...)
#

set -u

GSH_DIR=$(cd "$(dirname "$0")" && pwd)

MARK_START='# >>> gsh >>>'
MARK_END='# <<< gsh <<<'

# --- style -----------------------------------------------------------------
use_color() {
    # no-color.org: the variable disables colour by its presence, not its value
    [ -z "${NO_COLOR+x}" ] || return 1
    [ "${TERM:-}" != "dumb" ] || return 1
    [ -t 1 ]
}

use_unicode() {
    [ -z "${GSH_ASCII:-}" ] || return 1
    local loc="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
    # no locale set at all: modern terminals are UTF-8, assume so
    [ -n "$loc" ] || return 0
    case "$loc" in
    *[Uu][Tt][Ff]*) return 0 ;;
    *) return 1 ;;
    esac
}

if use_color; then
    C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
    C_RED=$'\033[0;31m'; C_GREEN=$'\033[0;32m'; C_YELLOW=$'\033[0;33m'
    C_BLUE=$'\033[0;34m'
else
    C_RESET=''; C_BOLD=''; C_DIM=''; C_RED=''; C_GREEN=''; C_YELLOW=''; C_BLUE=''
fi

if use_unicode; then
    I_OK='✓'; I_ERR='✗'; I_INFO='›'; I_DOT='•'
else
    I_OK='+'; I_ERR='x'; I_INFO='>'; I_DOT='*'
fi

ok()   { printf '%s %s\n' "${C_GREEN}${I_OK}${C_RESET}" "$*"; }
err()  { printf '%s %s\n' "${C_RED}${I_ERR}${C_RESET}" "$*" >&2; }
info() { printf '%s %s\n' "${C_BLUE}${I_INFO}${C_RESET}" "$*"; }
dot()  { printf '  %s %s\n' "${C_DIM}${I_DOT}${C_RESET}" "$*"; }
dim()  { printf '%s\n' "${C_DIM}$*${C_RESET}"; }

# --- the alias lines -------------------------------------------------------
# The block is shell source, so the install path has to survive two layers of
# quoting: '...' around the whole alias body and "..." around the path.
quote_path() {
    printf '%s' "$1" | sed -e 's/[\\"$`]/\\&/g' -e "s/'/'\\\\''/g"
}

Q_DIR=$(quote_path "$GSH_DIR")
ALIAS_GSH="alias gsh='bash \"$Q_DIR/gsh/main\"'"
ALIAS_UPD="alias gsh-update='bash \"$Q_DIR/update\"'"

block_body() {
    printf '%s\n' "$MARK_START"
    printf '%s\n' "# managed by the gsh installer - re-run setup to update this block"
    printf '%s\n' "$ALIAS_GSH"
    printf '%s\n' "$ALIAS_UPD"
    printf '%s\n' "$MARK_END"
}

printf '\n%sgsh%s %s- gitignore.sh%s\n\n' "$C_BOLD" "$C_RESET" "$C_DIM" "$C_RESET"

# --- detect the login shell ------------------------------------------------
# this script always runs under bash, so $ZSH_VERSION would never be set here
case "$(basename "${SHELL:-}")" in
zsh)
    info "zsh detected"
    RC_FILE="$HOME/.zshrc"
    ;;
bash)
    info "bash detected"
    if [ -f "$HOME/.bash_profile" ] && [ ! -f "$HOME/.bashrc" ]; then
        RC_FILE="$HOME/.bash_profile"
    else
        RC_FILE="$HOME/.bashrc"
    fi
    ;;
*)
    err "unsupported shell: ${SHELL:-unknown}"
    dim "  add these lines to your shell rc file by hand:"
    dim "    $ALIAS_GSH"
    dim "    $ALIAS_UPD"
    exit 1
    ;;
esac

# --- make sure we can actually write ---------------------------------------
# -w, not touch: touch succeeds on a mode-444 file you own, so the old check
# reported success after an append that never happened.
if [ ! -e "$RC_FILE" ]; then
    : >"$RC_FILE" || { err "cannot create $RC_FILE"; exit 1; }
fi
if [ ! -w "$RC_FILE" ]; then
    err "cannot write to $RC_FILE (permission denied)"
    dim "  fix: chmod u+w \"$RC_FILE\" && bash setup"
    dim "  or add these lines by hand:"
    dim "    $ALIAS_GSH"
    dim "    $ALIAS_UPD"
    exit 1
fi

# --- refuse to guess at a half-deleted block -------------------------------
# without both markers the strip below cannot tell where the block ends and
# would swallow the rest of the file.
HAS_START=0
HAS_END=0
grep -qF -- "$MARK_START" "$RC_FILE" && HAS_START=1
grep -qF -- "$MARK_END" "$RC_FILE" && HAS_END=1
if [ "$HAS_START" -ne "$HAS_END" ]; then
    err "$RC_FILE has one gsh block marker without its pair"
    dim "  setup will not guess where the block ends."
    dim "  fix: delete the leftover marker line from $RC_FILE, then re-run bash setup"
    exit 1
fi

# --- everything in the rc file that is not ours -----------------------------
# Drops the managed block and any line byte-identical to one we install (an
# older installer's copy), and keeps the rest verbatim.  The `|| [ -n ... ]`
# is what preserves a final line with no newline after it: read fails on it
# but still fills $line, and we print it with the newline it was missing.
strip_ours() {
    local line inblock=0
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in
        "$MARK_START") inblock=1; continue ;;
        "$MARK_END") inblock=0; continue ;;
        esac
        [ "$inblock" -eq 1 ] && continue
        case $line in
        "$ALIAS_GSH" | "$ALIAS_UPD") continue ;;
        esac
        printf '%s\n' "$line"
    done <"$RC_FILE"
}

# $(...) eats the trailing newlines, which is also what keeps repeated runs
# byte-stable: the blank line we put before the block is not re-counted.
KEPT=$(strip_ours)

CONFLICTS=$(printf '%s\n' "$KEPT" |
    grep -E '^[[:space:]]*alias[[:space:]]+gsh(-update)?=')

chmod +x "$GSH_DIR/gsh/main" "$GSH_DIR/update" 2>/dev/null

{
    [ -n "$KEPT" ] && printf '%s\n\n' "$KEPT"
    block_body
} >"$RC_FILE" || { err "cannot write $RC_FILE"; exit 1; }

ok "alias ${C_BOLD}gsh${C_RESET}"
ok "alias ${C_BOLD}gsh-update${C_RESET}"

if [ -n "$CONFLICTS" ]; then
    printf '\n'
    err "$RC_FILE has gsh alias line(s) that do not point at this install:"
    printf '%s\n' "$CONFLICTS" | while IFS= read -r line; do
        dim "      $line"
    done
    dim "  the managed block is written last, so 'gsh' still resolves here,"
    dim "  but the stale line will confuse the next person who reads $RC_FILE."
    dim "  fix: delete it from $RC_FILE - the block above already provides it."
fi

printf '\n'
ok "installed in ${C_BOLD}${GSH_DIR}${C_RESET}"
dim "  rc file: $RC_FILE"
printf '\n'
info "run ${C_BOLD}source $RC_FILE${C_RESET} (or open a new terminal), then:"
dim "    gsh auto      # in any project"
dim "    gsh doctor    # audit the repo"
printf '\n'
